{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.bindings.tsbuildinfo",
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/bindings-types",
    // Generated helpers this app doesn't call. Types stay fully checked.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/bindings.ts"],
  "exclude": []
}
